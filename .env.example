# Copy to .env for local dev. On cPanel, set these in
# Setup Node.js App -> Environment variables instead (see docs/deploy/cpanel-database.md).
#
# MONOREPO GOTCHA: this file lives at the repo root, which is where the
# Prisma CLI (generate / migrate / db seed) looks for .env. The Next.js app
# itself lives in apps/web/ and only reads env files from ITS OWN directory
# — a root-only .env is invisible to `npm run dev` / `npm run build`. You
# need a copy of this file in both places for local dev:
#   .env            (repo root — Prisma CLI reads this)
#   apps/web/.env   (Next.js app — `next dev`/`next build` read this)
# Both are gitignored; cPanel's env vars panel is the only thing that
# matters once deployed, this is purely for running things locally.

DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE?connection_limit=3&pool_timeout=20"

# Required. Registration, login, and CSV export all throw immediately if
# this is unset — see lib/session.ts and the api/v1 routes. HMAC key for IP
# hashing (audit logs) — see 01-technical-proposal.md §4 (Correction — IP
# hashing).
IP_HASH_PEPPER=""

# NOT CURRENTLY USED by any code. Session tokens are 32 random bytes hashed
# with SHA-256 for storage (packages/core/src/auth/session.ts) — that
# scheme needs no server-side secret. Left here as a placeholder in case a
# future signed-cookie approach needs it; safe to leave blank for now.
SESSION_SECRET=""

# NOT NEEDED YET. No code sends email — the newsletter double opt-in, DSR
# acknowledgements, and lockout warnings this is for (01-technical-proposal
# §3) aren't built. Leave blank until that's implemented; nothing currently
# reads these.
MAILER_API_KEY=""
MAILER_FROM="noreply@yourdomain.ac.ke"
